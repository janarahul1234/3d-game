# NeonVerse server configuration (copy to .env for local overrides)
# HTTP + WebSocket port for the game server
PORT=3001

# Comma-separated list of allowed browser origins (CORS + Socket.IO handshake)
# In production include your deployed frontend URL, e.g. https://play.example.com
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Maximum simultaneous players per room
MAX_PLAYERS_PER_ROOM=12

# Server snapshot broadcast rate (Hz). Higher = smoother relays, more bandwidth.
TICK_RATE=15

# Collectible respawn delay in milliseconds
ITEM_RESPAWN_MS=12000

# Number of simultaneously active collectibles per room
ACTIVE_ITEMS=10
